---
import Main from "../layouts/Main.astro";
const profilePicture =
  "https://static1.srcdn.com/wordpress/wp-content/uploads/2021/12/Peaky-Blinders-Is-Already-Teasing-Tommys-Perfect-Ending.jpg";
---

<Main>
  <div class="profile">
    <img
      alt="Tommy Shelby"
      width="150px"
      height="150px"
      src={profilePicture}
      class="profile__picture"
    />
    <div class="profile__details">
      <h1>Thomas Michael ‘Tommy’ Shelby OBE DCM MM MP</h1>
  <h2>Peaky Blinders</h2>
      <p>Leader of the Peaky Blinders gang</p>
    </div>
  </div>
</Main>
<style>
  .profile {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    padding: 1rem 0 3rem 0;
  }
  .profile__details {
    flex: 1 0 150px;
    padding: 0 1rem;
  }
  .profile__details > h1 {
    margin-top: 0;
  }

  .profile__picture {
    border-radius: 50%;
    margin: 0 2rem 1rem 0;
    object-fit: cover;
    transform: scale(1.25);
  }
</style>

<script>
  console.log("Hello from Astro!");
</script>